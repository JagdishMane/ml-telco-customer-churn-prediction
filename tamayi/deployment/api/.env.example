# Copy to .env and fill in to enable optional features.

# Override where the model artifacts live. Defaults to ../../models (tamayi/models).
# MODEL_DIR=C:/Git/ml-telco-customer-churn-prediction/tamayi/models

# Optional LLM for the conversational field-collection path. Leave unset to run the
# API without any LLM (the manual form still works end to end).
# Works with any OpenAI-compatible endpoint, e.g. DeepSeek or Qwen.

# DeepSeek example:
# LLM_API_KEY=sk-your-deepseek-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# Qwen via DashScope example:
# LLM_API_KEY=sk-your-dashscope-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
